{
  "name": "@laoliangfe/annotation-overlay-vue",
  "version": "1.0.0",
  "description": "Vue 3 annotation overlay component",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "watch": "concurrently \"vue-tsc --noEmit --watch\" \"vite build --watch\""
  },
  "peerDependencies": {
    "vue": "^3.5.39"
  },
  "dependencies": {
    "@laoliangfe/annotation-overlay-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.5"
  },
  "publishConfig": {
    "access": "public"
  }
}