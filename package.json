{
  "name": "annotation-overlay-monorepo",
  "private": true,
  "version": "2.0.0",
  "description": "Monorepo for Annotation Overlay - Vue 3 / React 18 / Angular 21 components with shared functional core & UI assets",
  "license": "MIT",
  "author": "love2157dream",
  "homepage": "https://love2157dream.github.io/annotation-overlay/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/love2157dream/annotation-overlay.git"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:vue": "turbo dev --filter=@laoliangfe/annotation-overlay-demo-vue",
    "dev:react": "turbo dev --filter=@laoliangfe/annotation-overlay-demo-react",
    "dev:angular": "turbo dev --filter=@laoliangfe/annotation-overlay-demo-angular",
    "build": "turbo build",
    "build:core": "turbo build --filter=@laoliangfe/annotation-overlay-core",
    "build:ui": "turbo build --filter=@laoliangfe/annotation-overlay-ui",
    "build:vue": "turbo build --filter=@laoliangfe/annotation-overlay-vue",
    "build:react": "turbo build --filter=@laoliangfe/annotation-overlay-react",
    "build:angular": "turbo build --filter=@laoliangfe/annotation-overlay-angular",
    "build:pages": "node scripts/build-pages.mjs",
    "docs": "node scripts/serve-docs.mjs",
    "docs:preview": "node scripts/serve-docs.mjs",
    "docs:build": "node scripts/build-pages.mjs && node scripts/serve-docs.mjs",
    "watch": "turbo run watch --filter=./packages/*",
    "watch:core": "turbo run watch --filter=@laoliangfe/annotation-overlay-core",
    "watch:vue": "turbo run watch --filter=@laoliangfe/annotation-overlay-vue",
    "watch:react": "turbo run watch --filter=@laoliangfe/annotation-overlay-react",
    "release": "pnpm build && pnpm -r publish --access public --no-git-checks",
    "release:dry": "pnpm build && pnpm -r publish --access public --no-git-checks --dry-run",
    "version:set": "node scripts/bump-version.mjs",
    "clean": "turbo clean",
    "clean:all": "turbo clean && rm -rf node_modules  && pnpm -r exec -- rm -rf node_modules && pnpm -r exec -- rm -rf dist",
    "format": "prettier --write \"**/*.{ts,tsx,vue,md}\"",
    "type-check": "pnpm -r exec -- tsc --noEmit"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "prettier": "^3.5.0",
    "turbo": "^2.0.0",
    "typescript": "~6.0.2",
    "vite": "8.1.1",
    "vite-plugin-dts": "4.5.0"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=18"
  }
}
